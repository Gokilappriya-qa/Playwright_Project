{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "components/**/*.spec.ts",
    "fixtures/**/*.ts",
    "pages/**/*.ts",
    "reporters/**/*.ts",
    "test-data/**/*.ts",
    "utils/**/*.ts",
    "playwright.config.ts",
    "runner.ts"
  ]
}
